{% extends "layout.twig" %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %}
    <main class="l-main">

        <div class="l-main__contentwrapper">

            <div class="l-main__content">
                <h1>{{ lang.not_found_heading }}</h1>
                <p>{{ lang.not_found_intro }}</p>
                <p>{{ lang.not_found_body|raw }}</p>

                {% if search_results|length > 0 %}
                    <p>{{ lang.not_found_suggestions }}</p>

                    <ul class="l-main-search__container">
                        {% for result in search_results %}
                            {% include "partials/search_result.twig" with {result: result} %}
                        {% endfor %}
                    </ul>


                    <div class="l-search__pagination">
                        <ul class="l-search__pagination-holder">
                            <li class="l-search-page l-search-page--active">
                                <a href="{{ url_for('search', {version: version, language: language}, {q: search_query}) }}" class="l-search-page__link l-search-page__link--active">
                                    {{ lang.not_found_more_results|format(search_query) }}
                                </a>
                            </li>
                        </ul>
                    </div>
                {% else %}
                    <p>{{ lang.not_found_use_search }}</p>
                {% endif %}
            </div>
        </div>
    </main>
{% endblock %}
